{
  "name": "ZPad",
  "identifier": "com.xiaoz.zpad",
  "version": "0.7.0",
  "out": "build",
  "resourcesExclude": ["icon.png"],
  "updates": {
    "publicKey": "VpjYZ2qwESl69oLtFpHFrYM2qgYptfUXYL5/u5K2jVA=",
    "github": "helloxz/zpad"
  },
  "i18n": {
    "dir": "locales",
    "source": "en"
  },
  "linux": {
    "maintainer": "xiaoz <xiaoz93@outlook.com>",
    "comment": "轻量、原生的文本编辑器",
    "categories": ["Utility", "TextEditor"],
    "command": "zpad",
    "webview": false,
    "formats": ["deb", "rpm"]
  },
  "fileAssociations": [
    {
      "ext": ["txt", "log", "csv",
              "md", "markdown", "mdx", "mkd",
              "html", "htm", "xhtml",
              "css", "scss", "less", "sass", "pcss",
              "xml", "json", "jsonc", "json5", "webmanifest",
              "js", "mjs", "cjs", "jsx", "ts", "tsx", "mts", "cts",
              "vue", "svelte",
              "yaml", "yml", "toml", "ini", "conf", "properties", "editorconfig",
              "diff", "patch", "rej"],
      "name": "Text Document",
      "mimeType": "text/plain"
    },
    {
      "ext": ["go", "py", "pyi", "pyw", "rs",
              "c", "h", "cpp", "cc", "cxx", "hpp", "hh", "hxx",
              "java", "kt", "kts", "scala", "swift", "dart", "cs",
              "rb", "rake", "lua", "php", "zig",
              "sh", "bash", "zsh", "fish", "ksh",
              "sql", "r", "proto", "graphql", "gql", "graphqls",
              "tf", "tfvars", "hcl", "nix",
              "erb", "rhtml", "tt", "j2", "jinja", "jinja2"],
      "name": "Source Code",
      "mimeType": "text/plain"
    }
  ]
}
